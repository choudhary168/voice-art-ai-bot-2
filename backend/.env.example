# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
# Model ID: gemini-3.8-live (or gemini-2.0-flash-exp / gemini-2.0-flash-realtime)
GEMINI_MODEL=gemini-3.8-live
VOICE_NAME=Aoede

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Audio Streaming Configuration
INPUT_SAMPLE_RATE=16000
OUTPUT_SAMPLE_RATE=24000
AUDIO_CHUNK_DURATION_MS=100

# Security & Diagnostic
MAX_WS_MESSAGE_SIZE_BYTES=5242880
DIAGNOSTIC_MODE=true

# PostgreSQL persistence (run Alembic migrations before enabling)
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/gemini_voice_agent
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ENABLED=true
PERSISTENCE_QUEUE_CAPACITY=1000
PERSISTENCE_RETRY_ATTEMPTS=3
PERSISTENCE_SHUTDOWN_TIMEOUT=5
ANONYMOUS_TOKEN_SECRET=replace_with_a_long_random_secret

# System Personality & Knowledge Configuration
DEFAULT_SYSTEM_INSTRUCTION="You are a helpful, responsive, and articulate real-time AI voice assistant powered by Gemini Live. Keep your answers concise, natural, and conversational by default. You can understand and converse fluently in English, Hindi, and Hinglish based on the user's preference and tone. Never invent personal information about the user. When answering, speak directly without unnecessary filler."
